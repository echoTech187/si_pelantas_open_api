{
  "version": 2,
  "redirects": [
    {
      "source": "/",
      "destination": "/api",
      "permanent": false
    },
    {
      "source": "/download/bk",
      "destination": "/downloads/sipelantas-bk.apk",
      "permanent": false
    },
    {
      "source": "/download/polri",
      "destination": "/downloads/sipelantas-polri.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/download/(.*)",
      "destination": "/api"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "DB_HOST": "gateway01.us-east-1.prod.aws.tidbcloud.com",
    "DB_PORT": "4000",
    "DB_NAME": "sipelantas_mojokerto",
    "DB_USER": "3g1AEyN52aykhaE.root",
    "DB_PASSWORD": "KPbxjvXA2Rsy7oev",
    "DB_SSL": "true",
    "JWT_ACCESS_SECRET": "sipelantas_mojokerto_kamsel_jwt_secret_access_2026_polres",
    "JWT_REFRESH_SECRET": "sipelantas_mojokerto_kamsel_jwt_secret_refresh_2026_polres"
  }
}
