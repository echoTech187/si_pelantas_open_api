# Server Configuration
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

# PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sipelantas_mojokerto
DB_USER=postgres
DB_PASSWORD=postgres_secret
DB_SSL=false

# JWT Security
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_access_secret_key_polantas_2026
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_refresh_secret_key_polantas_2026
JWT_ACCESS_EXPIRES_IN=8h

# Threshold Kamsel (Sesuai Spesifikasi WA: Peringatan di 5 pelanggar, Wajib Kunjungan di 7 pelanggar)
KAMSEL_WARNING_THRESHOLD=5
KAMSEL_VISIT_THRESHOLD=7

# Firebase Cloud Messaging (FCM)
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account-firebase.json

# Wablas WhatsApp Gateway Configuration
WABLAS_ENABLED=true
WABLAS_API_URL=https://pati.wablas.com/api/v2/send-message
WABLAS_API_TOKEN=replace_with_your_wablas_token
WABLAS_SECRET_KEY=replace_with_your_wablas_secret_key
